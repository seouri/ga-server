# Optional: override where the ga CLI reads its config (default: <repo>/.ga/config.json)
GA_CONFIG=

# Public https address of this machine (Tailscale Funnel), e.g. https://<machine>.<tailnet>.ts.net: turns on chat-app access in ga-gateway
GA_PUBLIC_URL=

# A second person on this computer (docs/operations.md, "A second person"): in the second copy of this folder, a project name and ports of its own
# COMPOSE_PROJECT_NAME=ga-server-2
# GA_FHIR_PORT=8203
# GA_APP_PORT=3100
# GA_GATEWAY_PORT=8210
