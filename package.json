{
  "name": "ga-server",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "ga": "./src/cli.ts"
  },
  "scripts": {
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:int": "vitest run --no-file-parallelism --dir tests/integration",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@medplum/core": "5.2.14",
    "@medplum/fhirtypes": "5.2.14",
    "@modelcontextprotocol/sdk": "1.32.2",
    "fast-xml-parser": "5.11.2",
    "jose": "6.2.15",
    "openid-client": "6.8.9",
    "pdfmake": "0.3.13",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pdfmake": "0.3.3",
    "@types/qrcode": "1.5.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@medplum/core": {
      "pdfmake": "$pdfmake"
    }
  }
}
